<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotThrow.Samples</RootNamespace>

    <!--
      "dotnet publish -r <rid>" builds a Native AOT binary, and every build runs the
      trimming and AOT analyzers. Set here, not with -p:PublishAot=true: a command-line
      property also reaches the netstandard2.0 library and fails with NETSDK1207.
    -->
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotThrow\DotThrow.csproj" />
  </ItemGroup>

</Project>
