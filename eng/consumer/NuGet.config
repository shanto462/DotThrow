<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- check.sh copies the packed .nupkg files into ./feed next to this file. -->
  <packageSources>
    <clear />
    <add key="local" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="DotThrow" />
      <package pattern="DotThrow.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
