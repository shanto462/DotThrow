<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 reaches .NET Framework 4.6.1+, Unity, Mono and Xamarin.
      netstandard2.1 adds spans for .NET Core 3.x to 7 and Unity.
      net462 gives .NET Framework a direct asset (no facade issues).
      net8.0, net9.0 and net10.0 get generic math, SearchValues, TimeProvider and AOT annotations.
    -->
    <TargetFrameworks>netstandard2.0;netstandard2.1;net462;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>DotThrow</RootNamespace>

    <!-- [module: SkipLocalsInit] needs unsafe code to be allowed. The library has no unsafe blocks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>true</IsPackable>
    <PackageId>DotThrow</PackageId>
    <Title>DotThrow</Title>
    <Description>Fluent guard clauses and validation for .NET. One chain of checks either throws the right exception with the parameter name filled in, or collects every error into a report. Zero dependencies, zero allocations on the happy path, AOT and trimming safe.</Description>
    <PackageTags>guard;guard-clauses;validation;validator;argument-validation;exceptions;throw;fluent;preconditions;defensive-programming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/shanto462/DotThrow/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    .NET Framework reference assemblies, so net462 builds on macOS and Linux too. The SDK
    adds this package by itself when the targeting pack is missing; the explicit reference
    pins the version through central package management and keeps it a build-time asset
    only, so the package never gets a dependency.
  -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <!-- DeflateStream for the built-in translations. A framework assembly, not a package. -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotThrow.Tests" />
  </ItemGroup>

  <!-- Built-in translations: Translations/*.txt, compressed and embedded at build time. -->
  <Import Project="Translations/Translations.targets" />

  <!--
    Roslyn analyzers and code fixes ship inside this package (analyzers/dotnet/cs), so users get
    them without another install. They are built once (netstandard2.0) and added to the package
    from the netstandard2.0 build; the library itself never references them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DotThrow.Analyzers.CodeFixes\DotThrow.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddDotThrowAnalyzersToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="AddDotThrowAnalyzersToPackage" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <MSBuild Projects="..\DotThrow.Analyzers\DotThrow.Analyzers.csproj;..\DotThrow.Analyzers.CodeFixes\DotThrow.Analyzers.CodeFixes.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_DotThrowAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_DotThrowAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
